generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int           @id @default(autoincrement())
  name                String
  email               String        @unique
  email_verified_at   DateTime?
  password            String
  role                UserRole      @default(ADMIN)
  remember_token      String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  createdApplications Application[] @relation("UserCreatedApplications")

  @@map("users")
}

model Citizen {
  id                  Int                @id @default(autoincrement())
  national_id         String             @unique
  first_name          String?
  father_name         String?
  grandfather_name    String?
  family_name         String?
  full_name           String?
  phone_number        String?
  email               String?
  whatsapp_number     String?
  mother_name         String?
  place_of_birth      String?
  country             String?
  date_of_birth       DateTime?
  gender              Gender?
  marital_status      MaritalStatus?
  status              CitizenStatus      @default(ALIVE)
  password            String?
  extra_data          Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  verification_status VerificationStatus @default(PENDING)
  locations           Location[]
  applications        Application[]
  bankAccounts CitizenBankAccount[]


  @@map("citizens")
}

model Location {
  id            Int          @id @default(autoincrement())
  citizenId     Int
  applicationId String?         
  type          LocationType
  extraData        Json?
  address         String?
  neighborhood   String?
  governorate   String?
  town          String?
  street        String?
  block_number  String?
  house_number  String?
  latitude      Decimal?     @db.Decimal(10, 7)
  longitude     Decimal?     @db.Decimal(10, 7)
  notes         String?
  status        LocationStatus  @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  application   Application? @relation("ApplicationToLocation", fields: [applicationId], references: [id])
  citizen       Citizen      @relation(fields: [citizenId], references: [id])

  @@map("locations")
}


model Person {
  id               Int       @id @default(autoincrement())
  national_id      String       @unique @map("ci_id_num")
  firstName        String?   @map("ci_first_arb")
  fatherName       String?   @map("ci_father_arb")
  grandfatherName  String?   @map("ci_grand_father_arb")
  familyName       String?   @map("ci_family_arb")
  birthTownCode    String?   @map("ci_birth_tb_cd")
  birthCode        String?   @map("ci_birth_cd")
  birthDate        String?   @map("ci_birth_dt")
  sexCode          String?   @map("ci_sex_cd")
  personalCode     String?   @map("ci_personal_cd")
  deathDate        String?   @map("ci_dead_dt")
  motherName       String?   @map("mother_name1")
  citizenship      String?   @map("citttty")
  city             String?   @map("city")
  street           String?   @map("street")
  region           String?   @map("regon")
  houseNumber      String?   @map("house_no")

  relations        Relation[] @relation("PersonRelations")   
  relatedTo        Relation[] @relation("RelativeRelations") 

  @@map("persons")
}


model Relation {
  id               Int     @id @default(autoincrement())
  personId         String     @map("cf_id_num")
  relationCodeId   Int     @map("cf_relative_cd")
  relativePersonId String     @map("cf_id_relative")

  person           Person  @relation("PersonRelations", fields: [personId], references: [national_id])
  relationCode     Code    @relation(fields: [relationCodeId], references: [id])
  relativePerson   Person  @relation("RelativeRelations", fields: [relativePersonId], references: [national_id])

  @@map("relations")
}


model Code {
  id           Int       @id @default(autoincrement())
  nameEn       String    @map("name_en")
  nameAr       String    @map("name_ar")

  relations    Relation[]

  @@map("codes")
}


model Application {
  id               String               @id @default(uuid())
  citizenId        Int
  type            String?
  status           ApplicationStatus @default(PENDING)
  notes            String?
  extraData        Json?
  createdById      Int? // User that created the application
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  citizen   Citizen   @relation(fields: [citizenId], references: [id])
  locations Location[] @relation("ApplicationToLocation")   // ← One-to-Many
  createdBy User?     @relation("UserCreatedApplications", fields: [createdById], references: [id])

  @@unique([citizenId])
  @@index([citizenId])
  @@map("applications")
}



model Bank {
  id        String                @id @default(uuid())
  enName      String
  arName      String
  swiftCode String?
  country   String?

  accounts  CitizenBankAccount[]

  createdAt DateTime              @default(now())
  @@map("banks")

}


model CitizenBankAccount {
  id                String   @id @default(uuid())
  citizenId         Int
  bankId            String

  accountHolderName String
  accountNumber     String   // encrypt at app level
  iban              String?
  accountType       AccountType
  currency          String   // ISO 4217 (USD, ILS, EUR)

  isPrimary         Boolean  @default(false)
  status            AccountStatus @default(ACTIVE)

  citizen           Citizen @relation(fields: [citizenId], references: [id])
  bank              Bank    @relation(fields: [bankId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([citizenId])
  @@index([bankId])
  @@map("citizen_bank_account")
}




enum AccountType {
  SAVINGS
  CURRENT
  WALLET
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}




enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum CitizenStatus {
  ALIVE
  DEAD
}

enum LocationType {
  BEFORE_WAR
  AFTER_WAR
  TEMPORARY
  CURRENT
}

enum UserRole {
  ADMIN
  SUPERVISOR
}

enum VerificationStatus {
  PENDING
  NATIONAL_ID_VERIFIED
  QUESTIONS_VERIFIED
  VERIFIED
}

enum ApplicationStatus {
  PENDING
  VERIFIED
  APPROVED
  REJECTED
  CLOSED
}

enum LocationStatus {
  PENDING
  VERIFIED
  APPROVED
  REJECTED
}
